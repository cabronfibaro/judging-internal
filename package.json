{
	"name": "judging-internal",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate --config=src/lib/server/db/drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate  --config=src/lib/server/db/drizzle.config.ts",
		"db:push": "drizzle-kit push     --config=src/lib/server/db/drizzle.config.ts",
		"db:studio": "drizzle-kit studio   --config=src/lib/server/db/drizzle.config.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.48.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24",
		"bits-ui": "^2.19.3",
		"cn": "^0.4.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@tanstack/svelte-query": "^6.3.0",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.3",
		"es-toolkit": "^1.52.0",
		"mode-watcher": "^1.1.0"
	}
}
